# --- required by the API (local dev + server) ---
ANTHROPIC_API_KEY=sk-ant-...
API_KEY=                      # optional shared secret for the HTTP API (empty = open)

# --- server stack only (the existing docker-compose on the server) ---
# postgres (n8n database)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
# n8n
N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com/
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# cloudflare tunnel
CF_TUNNEL_TOKEN=

# --- only if you still run bot.py locally as a smoke test ---
TELEGRAM_BOT_TOKEN=put_token_from_botfather_here
